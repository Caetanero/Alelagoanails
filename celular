    <script>
        const cursor = document.getElementById('cursor');
        const cursorDot = document.getElementById('cursor-dot');

        // LÓGICA DE ESTELA CON CANVAS
        const canvas = document.getElementById('trail-canvas');
        const ctx = canvas.getContext('2d');
        let points = [];

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        window.addEventListener('mousemove', (e) => {
            cursor.style.left = `${e.clientX}px`;
            cursor.style.top = `${e.clientY}px`;
            
            cursorDot.style.left = `${e.clientX}px`;
            cursorDot.style.top = `${e.clientY}px`;

            // Agrega punto a la estela
            points.push({
                x: e.clientX,
                y: e.clientY,
                radius: 4,
                alpha: 1
            });
        });

        function animateTrail() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            for (let i = 0; i < points.length; i++) {
                const p = points[i];
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(212, 175, 55, ${p.alpha})`;
                ctx.shadowBlur = 8;
                ctx.shadowColor = 'rgba(212, 175, 55, 0.8)';
                ctx.fill();

                // Reduce radio y opacidad progresivamente
                p.alpha -= 0.03;
                p.radius *= 0.96;

                // Elimina puntos desvanecidos
                if (p.alpha <= 0 || p.radius <= 0.2) {
                    points.splice(i, 1);
                    i--;
                }
            }
            requestAnimationFrame(animateTrail);
        }
        animateTrail();

        const interactivos = document.querySelectorAll('button, a, select');
        interactivos.forEach(el => {
            el.addEventListener('mouseenter', () => cursor.classList.add('hovered'));
            el.addEventListener('mouseleave', () => cursor.classList.remove('hovered'));
        });

        function toggleMenu() {
            const navMenu = document.getElementById('nav-menu');
            navMenu.classList.toggle('open');
        }

        function cambiarPestana(idSeccion, boton) {
            const secciones = document.querySelectorAll('.tab-content');
            secciones.forEach(sec => sec.classList.remove('active'));

            const botones = document.querySelectorAll('.nav-btn');
            botones.forEach(btn => btn.classList.remove('active'));

            document.getElementById(idSeccion).classList.add('active');
            boton.classList.add('active');

            const navMenu = document.getElementById('nav-menu');
            navMenu.classList.remove('open');

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        let carrito = [];

        function agregarAlCarrito(nombre, precio, selectId) {
            const talle = document.getElementById(selectId).value;
            carrito.push({ nombre, precio, talle });
            actualizarCarritoUI();
            alert(`¡${nombre} (Talle: ${talle}) fue agregado al carrito!`);
        }

        function actualizarCarritoUI() {
            const lista = document.getElementById('lista-carrito');
            const totalElemento = document.getElementById('total-precio');
            const countElemento = document.getElementById('cart-count');

            countElemento.textContent = carrito.length;

            if (carrito.length === 0) {
                lista.innerHTML = '<li style="color: #666;">El carrito está vacío.</li>';
                totalElemento.textContent = '0';
                return;
            }

            lista.innerHTML = '';
            let total = 0;

            carrito.forEach((item, index) => {
                total += item.precio;
                const li = document.createElement('li');
                li.className = 'carrito-item';
                li.innerHTML = `
                    <span><strong>${item.nombre}</strong> (Talle: ${item.talle}) - $${item.precio.toLocaleString('es-AR')}</span>
                    <button onclick="eliminarDelCarrito(${index})" style="background:none; border:none; color:red; cursor:pointer;">✕</button>
                `;
                lista.appendChild(li);
            });

            totalElemento.textContent = total.toLocaleString('es-AR');
        }

        function eliminarDelCarrito(index) {
            carrito.splice(index, 1);
            actualizarCarritoUI();
        }

        function enviarWhatsApp(e) {
            e.preventDefault();
            if (carrito.length === 0) {
                alert('El carrito está vacío. Agregá al menos un producto.');
                return;
            }

            let mensaje = '¡Hola! Quiero realizar el siguiente pedido:\n\n';
            let total = 0;

            carrito.forEach((item) => {
                mensaje += `• ${item.nombre} - Talle: ${item.talle} - $${item.precio.toLocaleString('es-AR')}\n`;
                total += item.precio;
            });

            mensaje += `\n*Total estimado:* $${total.toLocaleString('es-AR')}`;
            
            const numeroTelefono = '5491112345678'; 
            const url = `https://wa.me/${numeroTelefono}?text=${encodeURIComponent(mensaje)}`;
            window.open(url, '_blank');
        }
    </script>
</body>
</html>
